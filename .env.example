# ─── Required ────────────────────────────────────────────────────────────────
# Get yours from https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ─── Optional: restrict access ───────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone who can message the bot.
ALLOWED_USERS=

# ─── Download settings ───────────────────────────────────────────────────────
# Where files are saved on this machine
DOWNLOAD_DIR=/home/YOUR_USER/Music/LazyDJ

# Output audio format: mp3 | flac | wav | m4a | opus
AUDIO_FORMAT=mp3

# Bitrate for lossy formats (kbps)
AUDIO_QUALITY=320

# ─── Spotify (optional — only needed for Spotify URLs) ───────────────────────
# Create an app at https://developer.spotify.com/dashboard
# spotdl will fall back to public credentials if left empty.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Misc ────────────────────────────────────────────────────────────────────
# Path to a Netscape cookies.txt file for age-restricted YouTube content
COOKIES_FILE=

# Max simultaneous downloads (currently informational — enforced in future)
MAX_CONCURRENT_DOWNLOADS=3
